+bool NetworkManagerService::deactivateAccessPoint(const AccessPointInfo& ap) {
+  if (ap.devicePath.empty()) {
+    return false;
+  }
+  const std::string devicePath = ap.devicePath;
+  const std::weak_ptr<int> lifetimeToken = m_lifetimeToken;
+  try {
+    auto device = std::shared_ptr<sdbus::IProxy>(
+        sdbus::createProxy(m_bus.connection(), kNmBusName, sdbus::ObjectPath{devicePath})
+    );
+    device->callMethodAsync("Get")
+        .onInterface(kPropertiesInterface)
+        .withArguments(kNmDeviceInterface, "ActiveConnection")
+        .uponReplyInvoke([this, lifetimeToken, device, devicePath](
+                             std::optional<sdbus::Error> err, sdbus::Variant value
+                         ) {
+          if (lifetimeToken.expired()) {
+            return;
+          }
+          if (err.has_value()) {
+            kLog.warn("wifi ActiveConnection read failed path={}: {}", devicePath, err->what());
+            return;
+          }
+          std::string activePath;
+          try {
+            activePath = std::string{value.get<sdbus::ObjectPath>()};
+          } catch (const sdbus::Error&) {
+            return;
+          }
+          if (activePath.empty() || activePath == "/") {
+            return;
+          }
+          try {
+            m_nm->callMethodAsync("DeactivateConnection")
+                .onInterface(kNmInterface)
+                .withArguments(sdbus::ObjectPath{activePath})
+                .uponReplyInvoke([this, lifetimeToken, activePath](
+                                     std::optional<sdbus::Error> deactivateErr
+                                 ) {
+                  if (lifetimeToken.expired()) {
+                    return;
+                  }
+                  if (deactivateErr.has_value()) {
+                    kLog.warn("DeactivateConnection(wifi) failed path={}: {}", activePath, deactivateErr->what());
+                  } else {
+                    kLog.info("deactivated wifi connection path={}", activePath);
+                  }
+                  m_emitOnNextRefresh = true;
+                  requestRebind();
+                });
+          } catch (const sdbus::Error& e) {
+            kLog.warn("DeactivateConnection(wifi) dispatch failed: {}", e.what());
+          }
+        });
+  } catch (const sdbus::Error& e) {
+    kLog.warn("wifi ActiveConnection dispatch failed path={}: {}", devicePath, e.what());
+  }
+  return true;
+}
